/* ── Fluent-style navigation shell (dark) ──────────────────────── */

QWidget#navContainer {
    background: #1b1b1b;
    border-right: 1px solid #2e2e2e;
}

QTreeWidget#navTree {
    background: transparent;
    border: none;
    outline: none;
    font-size: 13px;
    padding-top: 8px;
}

QTreeWidget#navTree::item {
    min-height: 34px;
    border-radius: 6px;
    margin: 1px 8px;
    padding-left: 8px;
    color: #cfcfcf;
}

QTreeWidget#navTree::item:hover {
    background: #2a2a2a;
}

QTreeWidget#navTree::item:selected {
    background: #1e5f9e;
    color: #ffffff;
}

QTreeWidget#navTree::branch {
    background: transparent;
}

QStackedWidget#contentStack {
    background: #232323;
}

QLabel#settingsPageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #e6e6e6;
    padding: 4px 0 8px 0;
}

QToolBar#recognitionToolBar {
    background: #1f1f1f;
    border: none;
    border-bottom: 1px solid #2e2e2e;
    spacing: 4px;
    padding: 2px 6px;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QGroupBox {
    background: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #c8c8c8;
    font-weight: 600;
}

/* ── History / log ─────────────────────────────────────────────── */

QLabel#historyRealtimeLabel {
    background: #2d2d2d;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e0e0e0;
    font-size: 13px;
}

QLabel#historyTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #cfcfcf;
}

QPushButton#historyClearButton {
    color: #ff6b5e;
    font-size: 12px;
}

QPushButton#historyClearButton:hover {
    text-decoration: underline;
}

QPushButton[buttonRole="icon"] {
    background: transparent;
    border: none;
    padding: 4px;
}

QPushButton[buttonRole="icon"]:disabled {
    border: none;
}

QPushButton[buttonRole="icon"]:hover {
    background: #363636;
}

QPushButton[actionRole="use"]:hover {
    background: #1f3a28;
    border-color: #4caf50;
}

QPushButton[actionRole="download"]:hover {
    background: #16324f;
    border-color: #42a5f5;
}

QPushButton[actionRole="delete"]:hover {
    background: #3a1f22;
    border-color: #ef5350;
}

QLabel#hotwordsHintIcon {
    font-size: 18px;
}

QLabel#hotwordsHintLabel {
    color: #a5a5a5;
}

/* ── Voice overlay ─────────────────────────────────────────────── */

QWidget#voiceOverlay {
    background: rgba(16, 16, 18, 180);
    border: 1px solid rgba(255, 255, 255, 36);
    border-radius: 14px;
}

QWidget#voiceOverlayContainer {
    background: #2d2d2d;
    border-radius: 8px;
}

QLabel#voiceOverlayMicLabel {
    font-size: 24px;
    background: transparent;
    color: #e0e0e0;
}

QScrollArea#scrollTextArea {
    background: transparent;
    border: none;
}

QLabel#scrollTextLabel {
    color: #e0e0e0;
    font-size: 15px;
    background: transparent;
}
