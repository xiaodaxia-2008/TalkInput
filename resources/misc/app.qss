/* ── Fluent-style navigation shell ─────────────────────────────── */

QWidget#navContainer {
    background: #f5f5f5;
    border-right: 1px solid #e0e0e0;
}

QTreeWidget#navTree {
    background: transparent;
    border: none;
    outline: none;
    padding-top: 8px;
}

QTreeWidget#navTree::item {
    min-height: 30px;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    border: none;
}

QTreeWidget#navTree::item:hover {
    background: #f5f5f5;
    border: none;
}

QTreeWidget#navTree::item:selected {
    background: #dceaf7;
    color: #111111;
    border: none;
}

QTreeWidget#navTree::branch:selected {
    background: #dceaf7;
    border: none;
    image: none;
}

QTreeWidget#navTree::branch:hover {
    background: #f5f5f5;
    border: none;
}

QTreeWidget#navTree::branch {
    background: transparent;
    margin: 0;
}

QTreeWidget#navTree::branch:has-siblings:!adjoins-item,
QTreeWidget#navTree::branch:has-siblings:adjoins-item,
QTreeWidget#navTree::branch:!has-children:!has-siblings:adjoins-item {
    background: transparent;
    image: none;
}

QTreeWidget#navTree::branch:has-siblings:!adjoins-item:selected,
QTreeWidget#navTree::branch:has-siblings:adjoins-item:selected,
QTreeWidget#navTree::branch:!has-children:!has-siblings:adjoins-item:selected {
    background: #dceaf7;
    border: none;
    image: none;
}

QTreeWidget#navTree::branch:has-siblings:!adjoins-item:hover,
QTreeWidget#navTree::branch:has-siblings:adjoins-item:hover,
QTreeWidget#navTree::branch:!has-children:!has-siblings:adjoins-item:hover {
    background: #f5f5f5;
    border: none;
    image: none;
}

QTreeWidget#navTree::item:selected:hover {
    background: #dceaf7;
}

QTreeWidget#navTree::branch:has-siblings:!adjoins-item:selected:hover,
QTreeWidget#navTree::branch:has-siblings:adjoins-item:selected:hover,
QTreeWidget#navTree::branch:!has-children:!has-siblings:adjoins-item:selected:hover {
    background: #dceaf7;
    border: none;
    image: none;
}

QTreeWidget#navTree::branch:has-children:closed {
    image: url(:/resources/icons/chevron-right.svg);
}

QTreeWidget#navTree::branch:has-children:open {
    image: url(:/resources/icons/chevron-down.svg);
}

QSplitter#mainSplitter {
    background: transparent;
}

QSplitter#mainSplitter::handle {
    background: transparent;
    width: 6px;
}

QSplitter#mainSplitter::handle:hover,
QSplitter#mainSplitter::handle:pressed {
    background: #bcd9f7;
}

QStackedWidget#contentStack {
    background: #ffffff;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QGroupBox {
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #444;
    font-weight: 600;
}

QTextEdit,
QPlainTextEdit {
    background: #ffffff;
    color: #1f1f1f;
    border: 1px solid #cfcfcf;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #bcd9f7;
    selection-color: #1f1f1f;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #0078d4;
}

/* ── History / log ─────────────────────────────────────────────── */

QLabel#historyRealtimeLabel {
    background: #f5f5f5;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 8px 12px;
    color: #333;
    font-size: 13px;
}

QLabel#historyTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #444;
}

QPushButton#historyClearButton {
    color: #c0392b;
    font-size: 12px;
}

QPushButton#historyClearButton:hover {
    text-decoration: underline;
}

QPushButton[buttonRole="icon"] {
    background: transparent;
    border: none;
    padding: 4px;
}

QPushButton[buttonRole="icon"]:disabled {
    border: none;
}

QPushButton[buttonRole="icon"]:hover {
    background: #f0f0f0;
}

QPushButton[actionRole="use"]:hover {
    background: #e8f5e9;
    border-color: #2e7d32;
}

QPushButton[actionRole="download"]:hover {
    background: #e3f2fd;
    border-color: #1565c0;
}

QPushButton[actionRole="delete"]:hover {
    background: #ffebee;
    border-color: #c62828;
}

QLabel#hotwordsHintIcon {
    font-size: 18px;
}

QLabel#hotwordsHintLabel {
    color: #555;
}

QGraphicsView#previewLabel {
    border: 1px solid #cfcfcf;
    border-radius: 6px;
}

/* ── Voice overlay ─────────────────────────────────────────────── */

QWidget#voiceOverlay {
    background: rgba(16, 16, 18, 180);
    border: 1px solid rgba(255, 255, 255, 36);
    border-radius: 14px;
}

QWidget#voiceOverlayContainer {
    background: #2d2d2d;
    border-radius: 8px;
}

QLabel#voiceOverlayMicLabel {
    font-size: 24px;
    background: transparent;
    color: #e0e0e0;
}

QScrollArea#scrollTextArea {
    background: transparent;
    border: none;
}

QLabel#scrollTextLabel {
    color: #e0e0e0;
    font-size: 15px;
    background: transparent;
}
